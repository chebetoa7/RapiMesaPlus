<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RapiMesaApp.Views.MenuCategoriesPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Fondo dividido: Franja naranja a la izquierda, fondo claro a la derecha -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*" />
            <ColumnDefinition Width="6.5*" />
        </Grid.ColumnDefinitions>
        
        <BoxView Grid.Column="0" Color="{StaticResource Primary}" />
        <BoxView Grid.Column="1" Color="#F8F9FA" />

        <!-- Contenido superpuesto -->
        <Grid Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Título del Menú -->
            <VerticalStackLayout Grid.Row="0" Margin="30,60,30,30">
                <Label Text="Nuestro" FontSize="28" FontAttributes="Bold" TextColor="White" />
                <Label Text="Menú" FontSize="34" FontAttributes="Bold" TextColor="White" />
            </VerticalStackLayout>

            <!-- Lista de Categorías -->
            <ScrollView Grid.Row="1" Padding="0,0,0,30">
                <VerticalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            
                            <!-- Tarjeta de Categoría desfasada hacia el centro -->
                            <Frame Margin="50,0,30,0"
                                   Padding="15"
                                   BackgroundColor="White"
                                   CornerRadius="20"
                                   HasShadow="True"
                                   BorderColor="Transparent">
                                
                                <!-- Efecto de toque para navegar a los items -->
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="80, *, Auto">
                                    <!-- Círculo o imagen de la categoría -->
                                    <Frame Grid.Column="0" 
                                           WidthRequest="70" 
                                           HeightRequest="70" 
                                           CornerRadius="35" 
                                           Padding="0" 
                                           IsClippedToBounds="True" 
                                           HasShadow="False">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Frame>

                                    <!-- Textos de la categoría -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                        <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" TextColor="#222428" />
                                        <Label Text="{Binding ItemsCount, StringFormat='{0} platillos'}" FontSize="14" TextColor="#888" />
                                    </VerticalStackLayout>

                                    <!-- Ícono de flecha -->
                                    <Label Grid.Column="2" 
                                           Text="❯" 
                                           FontSize="18" 
                                           TextColor="{StaticResource Primary}" 
                                           VerticalOptions="Center" 
                                           Margin="0,0,10,0"/>
                                </Grid>
                            </Frame>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
