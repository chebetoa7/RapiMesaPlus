# API and Node
node_modules/
api/node_modules/
dist/
api/dist/
# OJO: la regla "lib/" (sin barra inicial) ignoraba CUALQUIER carpeta
# llamada lib, incluyendo RapiMesaFlutter/lib/ — que es el CÓDIGO FUENTE
# del cliente Flutter (24 archivos .dart). El repo se subió sin el cliente.
# Por eso aquí solo se ignora el compilado de la API, con ruta exacta.
DataConnect/api/lib/
.env
api/.env
api/key/
*.log

# Credenciales de Firebase / Google Cloud.
# NUNCA deben subirse al repositorio: la llave da control total del proyecto.
# En Cloud Functions no hace falta: el runtime provee Application Default Credentials.
*firebase-adminsdk*.json
serviceAccountKey.json
*service-account*.json
gcloud-key.json

# Registro de dispositivos push (tokens FCM). No debe subirse: son tokens de
# dispositivos reales de los clientes.
.push-devices.json
.push-devices.json.tmp

# Flutter Web (build generado)
RapiMesaFlutter/build/
DataConnect/api/public/app/

# Credenciales del modo QA (contraseña del conmutador y URL de la API en la
# red local). NUNCA se suben: la plantilla sí está en keylocal.example.txt.
keylocal.txt
*.local.txt

# Estado local de herramientas: no forman parte del proyecto.
# .firebase/  = caché de Firebase Hosting
# .opencode/  = base de datos y ajustes del agente (sesiones, memoria)
.firebase/
.opencode/

# Copia antigua de la API que quedó dentro de DataConnect/dataconnect/.
# El código vivo está en DataConnect/api/; esta copia es código muerto.
DataConnect/dataconnect/api/

# MAUI / .NET
[Bb]in/
[Oo]bj/
*.userprefs
*.user
*.suo
.vs/

# Mac
.DS_Store
